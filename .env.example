# doji local config. Copy to assets/env/.env (bundled by flutter_dotenv, gitignored)
# or pass the same keys with --dart-define / --dart-define-from-file=.env.
# --dart-define always wins over the .env file.
#
# Leave both empty to run fully local: onboarding is local-first and never
# needs the network.
SUPABASE_URL=
# The client key: a publishable key (sb_publishable_…) or a legacy anon key.
SUPABASE_ANON_KEY=
